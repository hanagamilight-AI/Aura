# Database Configuration
POSTGRES_USER=aiuser
POSTGRES_PASSWORD=aipassword
POSTGRES_DB=ai_companion

# ============================================
# LLM Provider Selection
# Options: 'ollama' (local), 'ollama_cloud', 'groq'
# ============================================
LLM_PROVIDER=ollama

# ============================================
# Ollama Configuration (Local or Cloud)
# ============================================
# For Local Ollama (default):
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_API_KEY=

# For Ollama Cloud (set LLM_PROVIDER=ollama_cloud and uncomment):
# OLLAMA_HOST=https://api.ollama.cloud
# OLLAMA_MODEL=qwen2.5:14b
# OLLAMA_API_KEY=your_ollama_cloud_api_key_here

# ============================================
# Groq Configuration (Free Tier Alternative)
# ============================================
# Get your API key from: https://console.groq.com/keys
# Set LLM_PROVIDER=groq to use
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# ============================================
# Telegram Bot Configuration
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# ============================================
# External API Keys (Optional for tools)
# ============================================
TAVILY_API_KEY=your_tavily_api_key_here

# ============================================
# Application Settings
# ============================================
APP_ENV=development
SECRET_KEY=your-secret-key-change-in-production
